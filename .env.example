# Vercel / server only
DATABASE_URL=postgres://...            # Neon via Vercel Marketplace. Locally: leave empty for an in-memory PGlite database
CHAIN_MODE=real                        # real | mock (mock fakes Polygon and Nimiq for local dev and e2e tests)
RELAYER_PRIVATE_KEY=0x...              # Polygon EOA that pays gas; Vercel Sensitive env var
RELAY_ADDRESS=0x...                    # CediNestRelay on Polygon mainnet (overrides shared/constants.ts)
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
NIMIQ_RPC_URL=https://rpc.nimiqwatch.com
NIM_FEE_ADDRESS=NQ.. .. .. ..          # receives NIM fees
SESSION_SECRET=...                     # HMAC for session tokens
CRON_SECRET=...                        # Vercel sends it as Bearer on cron calls

# App (public, baked into the bundle at build time)
VITE_RELAY_ADDRESS=0x...               # same as RELAY_ADDRESS, shown in the receipt
VITE_MOCK_WALLET=                      # 1 = fake Nimiq Pay + Polygon wallet in the browser (dev and tests only)

# contracts/ only
FORK_BLOCK=                            # pin a recent Polygon block for repeatable tests
DEPLOYER_PRIVATE_KEY=0x...
POLYGONSCAN_API_KEY=...
