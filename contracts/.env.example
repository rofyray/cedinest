# RPC used for both the local fork (hardhat network) and the `polygon` network
POLYGON_RPC_URL=https://polygon.drpc.org
# Optional: pin the fork to a block (leave empty to fork at latest)
FORK_BLOCK=
# Deployer key; the same key is used as the relayer by scripts/smoke-mainnet.ts
DEPLOYER_PRIVATE_KEY=
# For `npx hardhat verify`
POLYGONSCAN_API_KEY=
# Constructor args for scripts/deploy.ts
RELAYER_ADDRESS=
OWNER_ADDRESS=
