{
  "name": "cedinest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx scripts/dev-api.ts",
    "dev:mock": "CHAIN_MODE=mock VITE_MOCK_WALLET=1 npm run dev",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b && tsc -p tsconfig.api.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "copy:check": "tsx scripts/copy-check.ts",
    "db:migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@nimiq/mini-app-sdk": "^0.2.5",
    "@vercel/functions": "^3.11.0",
    "viem": "^2.57.16",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@vercel/node": "^30.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
